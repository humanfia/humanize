{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "humanize",
  "version": "0.2.0-beta.4",
  "identifier": "ai.humanfia.humanize",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "copyright": "© Humanfia, Apache-2.0",
    "fileAssociations": [
      {
        "ext": [
          "hmzepic"
        ],
        "name": "humanize epic",
        "role": "Viewer",
        "rank": "Owner",
        "mimeType": "application/vnd.hmz.epic+gzip",
        "exportedType": {
          "identifier": "ai.humanfia.humanize.epic",
          "conformsTo": [
            "public.data"
          ]
        }
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 720,
          "height": 612
        },
        "appPosition": {
          "x": 210,
          "y": 196
        },
        "applicationFolderPosition": {
          "x": 510,
          "y": 196
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQUZDQkVFQjNGOTZFOTQKUldTVWJ2bXo3c3V2YmV0Nk1TSjN1SEFDMWFLdVl3eEV1ZDc5UzIxTzZrUVI2OWJwb2ZoK1FXbW8K"
    }
  }
}

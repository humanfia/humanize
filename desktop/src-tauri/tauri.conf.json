{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "humanize",
  "version": "0.0.0",
  "identifier": "ai.humanfia.humanize",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "© Humanfia, Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 180 },
        "applicationFolderPosition": { "x": 480, "y": 180 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZEQUZDQkVFQjNGOTZFOTQKUldTVWJ2bXo3c3V2YmV0Nk1TSjN1SEFDMWFLdVl3eEV1ZDc5UzIxTzZrUVI2OWJwb2ZoK1FXbW8K",
      "endpoints": ["https://github.com/humanfia/humanize/releases/latest/download/latest.json"]
    }
  }
}

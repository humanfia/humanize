[10.839, "o", "\u001b[1;1H\u001b[49m                                                                                                            \u001b[0m\r\n\u001b[2;1H\u001b[49m  \u001b[0m\u001b[90;49mhmz\u001b[0m\u001b[90;49m › \u001b[0m\u001b[90;49m/flow\u001b[0m\u001b[90;49m › \u001b[0m\u001b[1;34;49mInstalled\u001b[0m\u001b[49m                                                                                 \u001b[0m\u001b[33;49m\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[3;1H\u001b[49m  \u001b[0m\u001b[90;49mFlows ready to run here: pick one to set it up and run it, or install more from a flowverse.\u001b[0m\u001b[49m            \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[4;1H\u001b[49m  \u001b[0m\u001b[49m                                                                                                        \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[5;1H\u001b[49m  \u001b[0m\u001b[90;49m╭\u001b[0m\u001b[90;49m──────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[90;49m╮\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[6;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[90;49m \u001b[0m\u001b[34;49mbuilt in\u001b[0m\u001b[90;49m                                                                                            \u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[7;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m \u001b[0m\u001b[1;39;49mchat\u001b[0m\u001b[39;49m                                                                                        \u001b[0m\u001b[90;49mbuilt in\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[8;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m   \u001b[0m\u001b[90;49mTalks to one agent for as long as you keep answering it.\u001b[0m\u001b[39;49m                                          \u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[9;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[90;49m─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[10;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m \u001b[0m\u001b[1;39;49mcontinue_loop\u001b[0m\u001b[39;49m                                                                               \u001b[0m\u001b[90;49mbuilt in\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[11;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m   \u001b[0m\u001b[90;49mSend the task once, then keep nudging \"continue\" until the budget is spent.\u001b[0m\u001b[39;49m                       \u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[12;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[90;49m─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[13;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m \u001b[0m\u001b[1;39;49mflame_chase\u001b[0m\u001b[39;49m                                                                                 \u001b[0m\u001b[90;49mbuilt in\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[14;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m   \u001b[0m\u001b[90;49mTwo agents take turns on the same task until the budget is spent.\u001b[0m\u001b[39;49m                                 \u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[15;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[90;49m─────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[49m \u001b[0m\u001b[90;49m│\u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[16;1H\u001b[49m  \u001b[0m\u001b[90;49m│\u001b[0m\u001b[39;49m \u
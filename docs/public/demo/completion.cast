[0.5, "o", "\u001b[1;1H\u001b[2;39;49m╭─\u001b[0m\u001b[2;39;49m \u001b[0m\u001b[2;39;49mHumanize v0.0.0\u001b[0m\u001b[2;39;49m \u001b[0m\u001b[2;39;49m──────────────────────────────────────────────────────\u001b[0m\u001b[2;39;49m─╮\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[1;107H\u001b[39;49m  \u001b[0m\r\n\u001b[2;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m                                                                         \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[2;107H\u001b[39;49m  \u001b[0m\r\n\u001b[3;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[34;49m██╗  ██╗██╗   ██╗███╗   ███╗ █████╗ ███╗   ██╗██╗███████╗███████╗\u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[3;107H\u001b[39;49m  \u001b[0m\r\n\u001b[4;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[34;49m██║  ██║██║   ██║████╗ ████║██╔══██╗████╗  ██║██║╚══███╔╝██╔════╝\u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[4;107H\u001b[39;49m  \u001b[0m\r\n\u001b[5;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[34;49m███████║██║   ██║██╔████╔██║███████║██╔██╗ ██║██║  ███╔╝ █████╗  \u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[5;107H\u001b[39;49m  \u001b[0m\r\n\u001b[6;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[34;49m██╔══██║██║   ██║██║╚██╔╝██║██╔══██║██║╚██╗██║██║ ███╔╝  ██╔══╝  \u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[6;107H\u001b[39;49m  \u001b[0m\r\n\u001b[7;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[34;49m██║  ██║╚██████╔╝██║ ╚═╝ ██║██║  ██║██║ ╚████║██║███████╗███████╗\u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[7;107H\u001b[39;49m  \u001b[0m\r\n\u001b[8;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[34;49m╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝╚═╝╚══════╝╚══════╝\u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[8;107H\u001b[39;49m  \u001b[0m\r\n\u001b[9;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[39;49m                                                                 \u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[9;107H\u001b[39;49m  \u001b[0m\r\n\u001b[10;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m    \u001b[0m\u001b[39;49mThe agent flow system for token maxxing.\u001b[0m\u001b[39;49m                         \u001b[0m\u001b[39;49m    \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[10;107H\u001b[39;49m  \u001b[0m\r\n\u001b[11;1H\u001b[2;39;49m│\u001b[0m\u001b[39;49m                                                                         \u001b[0m\u001b[2;39;49m│\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[11;107H\u001b[39;49m  \u001b[0m\r\n\u001b[12;1H\u001b[2;39;49m╰─────────────────────────────────────────────────────────────────────────╯\u001b[0m\u001b[39;49m                               \u001b[0m\u001b[12;107H\u001b[39;49m  \u001b[0m\r\n\u001b[13;1H\u001b[49m  \u001b[0m\u001b[34;49m/afk [on|off]      \u001b[0m\u001b[2;34;49mToggle whether an agent may ask you\u001b[0m\u001b[34;49m                                                  \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[14;1H\u001b[49m  \u001b[0m\u001b[39;49m/ai                \u001b[0m\u001b[2;39;49mTalk to Ai-chan, who operates hmz for you\u001b[0m\u001b[39;49m                                            \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[15;1H\u001b[49m  \u001b[0m\u001b[39;49m/clear             \u001b[0m\u001b[2;39;49mStart a new chat\u001b[0m\u001b[39;49m                                                                     \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[16;1H\u001b[49m  \u001b[0m\u001b[39;49m/epics [@daemon]   \u001b[0m\u001b[2;39;49mView and manage epics here, or of another daemon\u001b[0m\u001b[39;49m                                     \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[17;1H\u001b[49m  \u001b[0m\u001b[39;49m/exit              \u001b[0m\u001b[2;39;49mExit\u001b[0m\u001b[39;49m                                                                                 \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[18;1H\u001b[49m  \u001b[0m\u001b[39;49m/flow [flow] [task]\u001b[0m\u001b[2;39;49mSet up a flow, or start one on a task\u001b[0m\u001b[39;49m                                                \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[19;1H\u001b[49m  \u001b[0m\u001b[39;49m/prefer [native|flow]\u001b[0m\u001b[2;39;49mWhat $<name> runs where it names a skill and a flow\u001b[0m\u001b[39;49m                                \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[20;1H\u001b[49m  \u001b[0m\u001b[39;49m/quit              \u001b[0m\u001b[2;39;49mExit\u001b[0m\u001b[39;49m                                                                                 \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[21;1H\u001b[49m  \u001b[0m\u001b[39;49m/resume            \u001b[0m\u001b[2;39;49mResume an earlier chat here\u001b[0m\u001b[39;49m                                                          \u001b[0m\u001b[49m  \u001b[0m\r\n\u001b[22;1H\u001b[49m  \u001b[0m\u001b[39;49m/settings [page]   \u001b[0m\u001b[2;39;49mEvery setting: general, notifications, daemons, accounts, nous, runtimes, backup,\u001b[0m\u001b[39;49m    \u001b[0m\u001b[49m  \u001b[0m\u001b[25;4H\u001b[1;107H\u001b[39;49m  \u001b[0m\r\n\u001b[2;107H\u001b[39;49m  \u001b[0m\r\n\u001b[3;107H\u001b[39;49m  \u001b[0m\r\n\u001b[4;107H\u001b[39;49m  \u001b[0m\r\n\u001b[5;107H\u001b[39;49m  \u001b[0m\r\n\u001b[6;107H\u001b[39;49m  \u001b[0m\r\n\u001b[7;107H\u001b[39;49m